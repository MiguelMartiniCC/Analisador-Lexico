{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc.exe build Analisador Lexico",
            "command": "gcc",
            "args": [
                "-Wall",
                "-I${workspaceFolder}/Analisador_Lexico/include",
                "${workspaceFolder}/Analisador_Lexico/src/symbol_table.c",
                "${workspaceFolder}/Analisador_Lexico/src/lexer.c",
                "${workspaceFolder}/Analisador_Lexico/src/main.c",
                "-o",
                "${workspaceFolder}/Analisador_Lexico/lexer.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}/Analisador_Lexico"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compila o projeto Analisador Lexico inteiro."
        }
    ]
}
